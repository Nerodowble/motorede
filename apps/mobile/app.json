{
  "expo": {
    "name": "MotoRede",
    "slug": "motorede",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "motorede",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.motorede.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O MotoRede usa o microfone para a conversa por voz do comboio.",
        "NSLocationWhenInUseUsageDescription": "A localização mostra a distância entre os pilotos do comboio e é enviada num pedido de socorro.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "location"
        ]
      },
      "bitcode": false
    },
    "android": {
      "package": "br.com.motorede.app",
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "038193cd-0891-4a16-8857-febb8c340206"
      }
    },
    "owner": "willianvidallima"
  }
}