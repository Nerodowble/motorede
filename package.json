{
  "name": "motorede",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "livekit": "powershell -ExecutionPolicy Bypass -File scripts/livekit-dev.ps1",
    "dev:web": "npm run dev --workspace @motorede/web",
    "build:web": "npm run build --workspace @motorede/web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}