{
  "name": "motorede",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @motorede/web",
    "build:web": "npm run build --workspace @motorede/web",
    "lint": "npm run lint --workspaces --if-present"
  }
}
